{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun dist/server.js",
    "build": "bun run tools/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bun run tools/lint.ts",
    "format": "bun run tools/format.ts --write",
    "format:check": "bun run tools/format.ts --check",
    "verify": "bun ci --no-env-file --ignore-scripts --registry=https://registry.npmjs.org && bun --no-env-file run verify:ci",
    "verify:ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
