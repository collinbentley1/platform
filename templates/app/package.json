{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch dist/server.js",
    "start": "bun dist/server.js",
    "build": "bun run tools/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "bun run tools/format.ts --write",
    "format:check": "bun run tools/format.ts --check",
    "verify": "bun ci --no-env-file --ignore-scripts --registry=https://registry.npmjs.org && bun --no-env-file run verify:ci",
    "verify:ci": "bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "jose": "6.2.12",
    "firebase-admin": "14.5.0",
    "rate-limiter-flexible": "11.2.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
