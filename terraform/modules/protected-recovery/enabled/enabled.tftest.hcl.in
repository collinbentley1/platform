# The predicate of either exercise phase: an exception outside the form, an
# unrelated resource, a permission never observed, another image, a phase
# that is not what it claims, a deny run naming another control run, a deny
# request that is not the control request by its components or by its
# digest, a control request made against another pre-state, a deny pre-state
# unknown outside the ledger rows, a control operation that ended in error,
# an allow policy that moved between the phases or names no canary role at
# an attachment point, a co-denied permission whose own row is not isolated,
# a refusal without an IAM cause, and a permission the producer never
# exercised.
run "an_extra_exception_principal_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:extra-exception@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_canary_against_an_unrelated_resource_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:unrelated-resource@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_required_permission_never_observed_denied_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:missing-observation@@
  }

  assert {
    condition     = contains(local.unsatisfied_deny_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccountKeys.create") && contains(local.evidence_failures, "coverage_complete")
    error_message = "A row whose denial was never observed must be named unsatisfied and fail coverage_complete."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_required_permission_never_observed_allowed_in_the_control_phase_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["control"]
    @@VERIFICATION:control:missing-observation@@
  }

  assert {
    condition     = contains(local.unsatisfied_deny_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccountKeys.create")
    error_message = "A denial with no successful control of the same request is not evidence of the rule."
