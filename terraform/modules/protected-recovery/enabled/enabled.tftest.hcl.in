      status_code   = 200
      response_body = <<-JSON
        {"id":100000000003,"name":"deny-canary","digest":"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff","expired":false,"workflow_run":{"id":100000000002,"head_sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}
      JSON
    }
  }

  expect_failures = [google_project_iam_custom_role.actuator]
}

