# The live Deny state is bound to the attested one on every apply: a policy
# changed, widened, conditioned, narrowed, or deleted since the canary
# refuses the apply although the canary records are untouched.
run "a_live_policy_whose_etag_moved_since_the_canary_is_refused" {
  command = apply

  @@LIVE_DENY_POLICY:etag-moved@@

  assert {
    condition     = !local.live_matches_canary && contains(local.evidence_failures, "deny_state_current")
    error_message = "A live policy at another etag than the attested one must fail deny_state_current."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_live_exception_widened_since_the_canary_is_refused" {
  command = apply

  @@LIVE_DENY_POLICY:exception-widened@@

  assert {
    condition     = contains(local.evidence_failures, "deny_state_required") && length(local.live_unsatisfied_rows) > 0
    error_message = "A live rule with an extra exception principal must leave its rows unsatisfied by the live state."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_live_condition_added_since_the_canary_is_refused" {
  command = apply

  @@LIVE_DENY_POLICY:condition-added@@

  assert {
    condition     = contains(local.evidence_failures, "deny_state_required")
    error_message = "A live rule narrowed by a denial condition must leave its rows unsatisfied by the live state."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_required_permission_the_live_state_does_not_deny_is_refused" {
  command = apply

  @@LIVE_DENY_POLICY:permission-missing@@

  assert {
    condition     = local.missing_live_permissions == tolist(["cloudresourcemanager.googleapis.com/projects/recovery-test|cloudresourcemanager.googleapis.com/projects.setIamPolicy"]) && contains(local.evidence_failures, "supported")
    error_message = "A required permission no live rule denies must be reported as missing and block activation."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_live_policy_deleted_since_the_canary_is_refused" {
  command = apply

  @@LIVE_DENY_LISTING:missing@@

  assert {
    condition     = !local.live_matches_canary && contains(local.evidence_failures, "deny_state_current")
    error_message = "An attested policy the live state no longer lists must fail deny_state_current."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

# A consumer attachment row rests on a disabled API only while the API is
# disabled: an enabled Compute API turns its three rows into unproven rows.
run "an_unserviceable_row_whose_api_is_live_enabled_is_refused" {
  command = apply

  @@LIVE_SERVICE_STATE:runsetta:compute.googleapis.com:ENABLED@@

  assert {
    condition     = length(local.unserviceable_rows) == 13 && contains(local.unsatisfied_deny_rows, "cloudresourcemanager.googleapis.com/projects/runsetta|compute.googleapis.com/instances.create") && contains(local.evidence_failures, "coverage_complete")
    error_message = "A SERVICE_DISABLED observation beside a live read that says the API is enabled must leave the row unsatisfied."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "an_unserviceable_row_whose_api_cannot_be_read_is_refused" {
  command = apply

  @@LIVE_SERVICE_STATE:cdbentley:cloudbuild.googleapis.com:unread@@

  assert {
    condition     = contains(local.evidence_failures, "services_read") && contains(local.unsatisfied_deny_rows, "cloudresourcemanager.googleapis.com/projects/cdbentley|cloudbuild.googleapis.com/builds.create")
    error_message = "A service state that cannot be read must fail services_read and leave the row unsatisfied."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

# The canary's temporary Allows must be gone live at every attachment point
# before the broker gains authority; a role still bound, or a policy that
# cannot be read, refuses the apply.
run "a_canary_allow_still_standing_live_is_refused" {
  command = apply

  @@LIVE_ALLOW_STATE:recovery-test:standing@@

  assert {
    condition     = !local.canary_allows_retired && contains(local.evidence_failures, "canary_allows_retired") && !contains(local.evidence_failures, "allows_read")
    error_message = "A canary role still bound live at an attachment point must fail canary_allows_retired."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "an_allow_policy_that_cannot_be_read_live_is_refused" {
  command = apply

  @@LIVE_ALLOW_STATE:cdbentley:unread@@

  assert {
    condition     = contains(local.evidence_failures, "allows_read") && contains(local.evidence_failures, "canary_allows_retired")
    error_message = "An allow policy that cannot be read live must fail allows_read and canary_allows_retired."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

# The consumer ancestry is read at apply behind the fence: a project moved
# out of the evidenced organization is refused at the moment of the grant.
run "a_consumer_project_outside_the_evidenced_organization_is_refused" {
  command = apply

  override_data {
    target = data.google_project.consumer["runsetta"]
    values = { org_id = "200000000009" }
  }

  expect_failures = [data.google_project.consumer]
}

run "without_evidence_nothing_is_granted_even_with_every_identity_recorded" {
  command = plan

  variables {
    broker_authority_evidence = null
  }

  assert {
    condition     = local.identities_recorded && length(data.google_service_account.target) == 0 && length(google_project_iam_custom_role.actuator) == 0 && length(google_service_account_iam_member.actuator) == 0 && length(google_project_iam_custom_role.inventory) == 0 && length(google_organization_iam_custom_role.inventory) == 0 && length(data.external.service_state) == 0 && length(data.external.allow_state) == 0
    error_message = "Recorded identities alone must grant nothing; only verified evidence enables authority."
  }
}

# Every adversarial apply above left the evidenced grants exactly as step two
# made them; withdrawing the evidence revokes them.
run "activation_step_three_revokes_authority_when_evidence_is_withdrawn" {
  command = apply

  variables {
    broker_authority_evidence = null
  }

  assert {
    condition     = length(google_project_iam_custom_role.actuator) == 0 && length(google_service_account_iam_member.actuator) == 0 && length(google_project_iam_member.broker_inventory) == 0 && length(google_organization_iam_member.broker_inventory) == 0 && length(google_service_account_iam_member.member_authority) == 61
    error_message = "Withdrawing the evidence must revoke every cross-project grant and keep the broker project's own identities."
  }
}
