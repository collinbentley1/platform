# The enabled path of the protected-recovery module: every target's permanent
# unique ID recorded and verified live, and the Deny canary evidence verified
# against GitHub's run, artifact, and attestation records. The committed
# authority records no identity and no such records exist offline, so
# tools/ci/protected-recovery-enabled-test.sh renders this template into an
# isolated copy of the repository whose authority.json records a test identity
# for each of the thirty-six targets, and whose mocked GitHub reads answer with
# fixtures/deny-canary.json and its adversarial variants. A line consisting of
# an ATTESTATION placeholder names the variant rendered there:
#
#   consistent           the fixture as attested
#   extra-exception      one extra exception principal on one rule
#   unrelated-resource   the broker-project rules attached to another project
#   unsupported          a required permission reported unsupported and omitted
#   missing-observation  a required permission listed but never observed DENIED
#   other-image          a canary of another broker image
#
# and the ARTIFACT_SHA256 placeholder is the digest of the fixture bytes.
# These are mocked plan-shape tests: they prove what the gate does with each
# record, not that GitHub or Google answer as modelled. The identity of the
# test accounts is 1 + consumer index + account index + sixteen zeros, in the
# sorted order of protected-recovery/authority.json.

mock_provider "google" {}
mock_provider "http" {}

override_data {
  target = data.google_project.current
  values = {
    number = "123456789012"
  }
}

