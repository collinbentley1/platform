run "a_co_denied_row_without_an_isolated_proof_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:actas-unisolated@@
  }

  assert {
    condition     = contains(local.co_denied_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.actAs") && contains(local.unsatisfied_deny_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|run.googleapis.com/services.create") && !contains(local.unsatisfied_deny_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccountKeys.create") && contains(local.evidence_failures, "coverage_complete")
    error_message = "When the actAs exercise itself needs a second denied permission, every row that rests on an isolated actAs proof is unsatisfied and coverage fails; rows proven on their own stand."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

