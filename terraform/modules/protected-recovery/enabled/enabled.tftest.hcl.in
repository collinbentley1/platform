run "a_required_permission_never_observed_denied_is_refused" {
  command = plan

  override_data {
    target = data.http.canary_attestations[0]
    values = {
      status_code   = 200
      response_body = <<-JSON
        @@ATTESTATION:missing-observation@@
      JSON
    }
  }

  expect_failures = [google_project_iam_custom_role.actuator]
}

run "evidence_of_another_broker_image_is_refused" {
  command = plan

  override_data {
    target = data.http.canary_attestations[0]
    values = {
      status_code   = 200
      response_body = <<-JSON
        @@ATTESTATION:other-image@@
      JSON
    }
  }

  expect_failures = [google_project_iam_custom_role.actuator]
}

run "a_consumer_project_outside_the_evidenced_organization_is_refused" {
  command = plan

  override_data {
    target = data.google_project.consumer["runsetta"]
    values = { org_id = "200000000009" }
  }

  expect_failures = [data.google_project.consumer]
}

run "without_evidence_nothing_is_granted_even_with_every_identity_recorded" {
  command = plan

  variables {
    broker_authority_evidence = null
  }

  assert {
    condition     = local.identities_recorded && length(data.google_service_account.target) == 0 && length(google_project_iam_custom_role.actuator) == 0 && length(google_service_account_iam_member.actuator) == 0 && length(google_project_iam_custom_role.inventory) == 0 && length(google_organization_iam_custom_role.inventory) == 0
    error_message = "Recorded identities alone must grant nothing; only verified evidence enables authority."
  }
}
