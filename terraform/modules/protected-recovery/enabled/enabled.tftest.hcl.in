# The enabled path of the protected-recovery module: every target's permanent
# unique ID recorded and verified live, all three phases of the Deny canary
# verified and bound to their signer and to each other, the live Deny state
# bound to the attested one, the consumer attachment rows that rest on a
# disabled API bound to a live read of that API, the canary's temporary
# Allows bound in both exercise phases and read retired live, and every one
# of those reads made at apply behind the fence. The committed authority
# records no identity and no such records exist offline, so
# tools/ci/protected-recovery-enabled-test.sh renders this template into an
# isolated copy of the repository whose authority.json records a test
# identity for each of the thirty-six targets and the active platform commit
# for every consumer (plus a transition commit for runsetta), and whose
# mocked reads answer with the three predicates the canary producer's own
# shape renders (tools/ci/protected-recovery-canary-fixture.ts) and their
# adversarial variants. A line consisting of one of these placeholders (each
# wrapped in double at-signs) names the record rendered there:
#
#   TARGET_IDENTITIES   the thirty-six live account reads, each resolving to
#       its recorded unique ID
#   VERIFICATION:<phase>:<variant>   the verified attestation of one phase,
#       as tools/ci/protected-recovery-verify-canary.sh answers it; variants
#       consistent, unverified, other-workflow, other-run, other-head,
#       other-repository, self-hosted (the certificate), extra-exception,
#       unrelated-resource, missing-observation, other-image, other-phase,
#       other-control, request-mismatch, digest-mismatch, pre-state-mismatch,
#       pre-state-unknown, operation-error, allow-etag-moved, allow-missing,
#       actas-unisolated, missing-cause, unexercised, cleanup-leftover (the
#       predicate), run-missing, run-other-head, artifact-digest,
#       control-after-deny, cleanup-before-deny (the records)
#   LIVE_DENY_STATE   the live deny policies of every attachment point,
#       listed and read, exactly as the deny phase attested them
#   LIVE_DENY_POLICY:<variant>   the broker project's live policy with one
#       deviation: etag-moved, exception-widened, condition-added,
#       permission-missing
#   LIVE_DENY_LISTING:missing   the broker project's listing without its
#       policy
#   LIVE_SERVICE_STATE   every consumer project's Compute and Cloud Build
#       API read, disabled
#   LIVE_SERVICE_STATE:<project>:<service>:<state>   one such read with the
#       given state
#   LIVE_ALLOW_STATE   the canary's roles at every attachment point, read
#       live: none anywhere
#   LIVE_ALLOW_STATE:<project>:<variant>   one such read: standing (a role
#       still bound) or unread
#
# and the RAW_<phase> and ARCHIVE_<phase> placeholders are the digests of each
# phase's fixture bytes and of its archive. These are mocked apply-shape
# tests: they prove what the gate does with each record at the mutation
# boundary and that the activation sequence is permitted by the matrix it
# requires, not that GitHub, gh, or Google answer as modelled. Because every
# live read sits behind the fence, which every apply replaces, an
# adversarial record is judged by a mocked apply that must refuse the grant
# and leave the standing grants as they are. The identity of the test
# accounts is 1 + consumer index + account index + sixteen zeros, in the
# sorted order of protected-recovery/authority.json.

# The mocked apply of the activation sequence needs the computed names the
# dependent IAM resources validate to be well-formed; the values are shapes,
# not identities.
mock_provider "google" {
  mock_resource "google_service_account" {
    defaults = {
      email = "mocked@recovery-test.iam.gserviceaccount.com"
      name  = "projects/recovery-test/serviceAccounts/mocked@recovery-test.iam.gserviceaccount.com"
    }
  }
  mock_resource "google_project_iam_custom_role" {
    defaults = {
      name = "projects/recovery-test/roles/mocked"
    }
  }
  mock_resource "google_organization_iam_custom_role" {
    defaults = {
      name = "organizations/100000000001/roles/mocked"
    }
  }
}
mock_provider "external" {}

override_data {
  target = data.google_project.current
  values = {
    number = "123456789012"
    org_id = "100000000001"
  }
}

override_data {
  target = data.google_client_openid_userinfo.deployer
  values = {
    email = "cloud-root@cdbentley.com"
  }
}

override_data {
  target = data.google_project.consumer["cdbentley"]
  values = { org_id = "100000000001" }
}
override_data {
  target = data.google_project.consumer["critical-history"]
  values = { org_id = "100000000001" }
}
override_data {
  target = data.google_project.consumer["healthmcp"]
  values = { org_id = "100000000001" }
}
override_data {
  target = data.google_project.consumer["runsetta"]
  values = { org_id = "100000000001" }
}

@@TARGET_IDENTITIES@@

# All three phases of the canary, verified: the run and artifact records,
# the two digests, the certificate, and the statement carrying the predicate.
override_data {
  target = data.external.canary_verification["control"]
  @@VERIFICATION:control:consistent@@
}
override_data {
  target = data.external.canary_verification["deny"]
  @@VERIFICATION:deny:consistent@@
}
override_data {
  target = data.external.canary_verification["cleanup"]
  @@VERIFICATION:cleanup:consistent@@
}

@@LIVE_DENY_STATE@@

@@LIVE_SERVICE_STATE@@

@@LIVE_ALLOW_STATE@@

variables {
  project_id          = "recovery-test"
  broker_image        = "us-east4-docker.pkg.dev/recovery-test/broker/protected-recovery@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  active_workflow_sha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  broker_authority_evidence = {
    organization_id = "100000000001"
    deny_control = {
      run_id          = "100000000001"
      artifact_id     = "100000000002"
      artifact_sha256 = "@@RAW_control@@"
      archive_sha256  = "@@ARCHIVE_control@@"
    }
    deny_canary = {
      run_id          = "100000000003"
      artifact_id     = "100000000004"
      artifact_sha256 = "@@RAW_deny@@"
      archive_sha256  = "@@ARCHIVE_deny@@"
    }
    deny_cleanup = {
      run_id          = "100000000005"
      artifact_id     = "100000000006"
      artifact_sha256 = "@@RAW_cleanup@@"
      archive_sha256  = "@@ARCHIVE_cleanup@@"
    }
  }
}

# The activation sequence from an empty broker project, applied with mock
# providers and state carried from run to run: the broker project alone
# without evidence (this run), the evidenced grants once the Deny state stands
# and every mutation the apply makes is permitted its principal (the next
# run), every adversarial record refused at apply with the grants left exactly
# as they stand (the runs after it), and revocation of the grants when the
# evidence is withdrawn (the last run). Every live read is made behind the
# apply-time fence, which every apply replaces, so each adversarial record is
# judged by an apply that reads the live state at the mutation boundary and
# refuses the grant there.
run "activation_step_one_installs_the_broker_project_alone" {
  command = apply

  variables {
    broker_authority_evidence = null
  }

  assert {
    condition     = length(google_project_iam_custom_role.actuator) == 0 && length(google_service_account_iam_member.actuator) == 0 && length(google_project_iam_member.broker_inventory) == 0 && length(google_organization_iam_member.broker_inventory) == 0 && length(data.google_project.consumer) == 0
    error_message = "Step one must create nothing in any consumer project and read none."
  }

  assert {
    condition     = length(google_service_account_iam_member.invoker_authority) == 8 && length(google_service_account_iam_member.member_authority) == 61 && length(google_service_account_iam_member.canary_authority) == 1 && length(google_cloud_run_v2_service_iam_member.invokers) == 13 && google_iam_workload_identity_pool_provider.members.workload_identity_pool_provider_id == "github-members"
    error_message = "Step one must create the broker project's identities and their bindings: invokers, member-delivery identities, and the Deny canary, so the canary can run before any grant exists."
  }
}

run "verified_evidence_and_verified_identities_grant_exactly_the_thirty_six_actuators" {
  command = apply

  assert {
    condition     = local.evidence_verified && length(local.evidence_failures) == 0 && length(local.unsatisfied_deny_rows) == 0 && length(local.live_unsatisfied_rows) == 0 && length(local.missing_live_permissions) == 0 && length(local.activation_blocked) == 0
    error_message = "Consistent records must pass every check with no unsatisfied Deny row, every live row as required, no required permission the live state does not deny, and no blocked activation mutation; failed checks [${join(", ", local.evidence_failures)}], unsatisfied rows [${join(", ", local.unsatisfied_deny_rows)}], live rows [${join(", ", local.live_unsatisfied_rows)}], missing [${join(", ", local.missing_live_permissions)}], blocked [${join(", ", local.activation_blocked)}]."
  }

  assert {
    condition     = local.verified.control && local.verified.deny && local.verified.cleanup && local.certificate_bound.control && local.certificate_bound.deny && local.certificate_bound.cleanup && local.certificates.deny.buildSignerURI == "https://github.com/collinbentley1/platform/.github/workflows/protected-recovery-deny-canary.yml@refs/heads/main" && local.certificates.control.runInvocationURI == "https://github.com/collinbentley1/platform/actions/runs/100000000001/attempts/1" && local.certificates.deny.runInvocationURI == "https://github.com/collinbentley1/platform/actions/runs/100000000003/attempts/1" && local.certificates.cleanup.runInvocationURI == "https://github.com/collinbentley1/platform/actions/runs/100000000005/attempts/1" && local.certificates.deny.sourceRepositoryDigest == var.active_workflow_sha
    error_message = "Each phase's verified certificate must bind its predicate to the deny-canary workflow at the active commit, the phase's own run, and the platform repository."
  }

  assert {
    condition     = local.predicates.control.phase == "control" && local.predicates.deny.phase == "deny" && local.predicates.cleanup.phase == "cleanup" && tostring(local.predicates.deny.controlRunId) == "100000000001" && tostring(local.predicates.cleanup.controlRunId) == "100000000001" && local.evidence_checks.control_before_deny && local.evidence_checks.cleanup_after_deny && local.evidence_checks.cleanup_predicate_bound
    error_message = "The deny phase must name the control run and follow it in time, and the cleanup must name the control run, follow the deny run, and have left nothing over."
  }

  # Every required row is proven by the pair -- a DENIED observation naming
  # the row's permission beside an ALLOWED observation of the request of the
  # same digest in the same pre-state -- except the sixteen consumer Compute
  # and Cloud Build rows, which rest on the identical request answering
  # SERVICE_DISABLED in both phases beside the live read proving each API
  # disabled.
  assert {
    condition     = length([for key, satisfied in local.deny_pair_satisfied : key if satisfied]) == 35 + 10 + 4 * 25 && local.unserviceable_rows == sort(flatten([for attachment in values(local.consumer_attachments) : [for permission in keys(local.unserviceable_permissions) : "${attachment}|${permission}"]])) && length(local.unserviceable_rows) == 16 && length(data.external.service_state) == 8 && length(local.service_reads) == 8
    error_message = "Exactly the consumer Compute and Cloud Build rows may rest on a disabled API, each beside its live read; every other row must be proven by the paired denial."
  }

  # The twenty-seven rows whose request needs a second denied permission --
  # every Cloud Run write (actAs) and the implicit-delegation chain (the
  # delegate's getAccessToken) -- are proven beside the isolated proof of
  # that permission's own row; every other row is proven on its own.
  assert {
    condition     = length(local.co_denied_rows) == 27 && contains(local.co_denied_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|run.googleapis.com/services.create") && contains(local.co_denied_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.implicitDelegation") && contains(local.co_denied_rows, "cloudresourcemanager.googleapis.com/projects/cdbentley|run.googleapis.com/workerpools.update") && !contains(local.co_denied_rows, "cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.actAs") && local.deny_row_isolated["cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.actAs"] && local.deny_row_isolated["cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.getAccessToken"] && alltrue(values(local.isolation_satisfied))
    error_message = "The Cloud Run writes and the delegation chain are the co-denied rows; actAs and getAccessToken are proven in isolation, so every co-denied row is satisfied."
  }

  assert {
    condition     = local.allow_bound && local.evidence_checks.allows_bound && local.canary_allows_retired && length(data.external.allow_state) == 6 && length(local.allow_reads) == 6 && length(keys(local.canary_allows.control)) == 8 && length(local.canary_allows.control["organizations/100000000001"].canary) > 0 && length(local.canary_allows.control["projects/recovery-test/serviceAccounts/deny-canary-100000000001@recovery-test.iam.gserviceaccount.com"].delegate) == 1
    error_message = "Both exercise phases must record the same Allows at every attachment point and on the throwaway accounts, and the live read at every attachment point must find the canary's roles gone."
  }

  assert {
    condition     = local.live_matches_canary && length(data.external.deny_state) == 6 && length(local.live_rules) == 13 && length(local.required_deny_matrix) == 35 + 4 * 29 + 10 && local.live_overlay == "steady"
    error_message = "Every attachment point's live deny policies must be read and be exactly the attested ones, the whole matrix must be carried by them, and the live overlay must be steady."
  }

  # The matrix the broker runtime derives (protected-recovery/src/deny.ts)
  # and the one this module derives are one definition: every form equal.
  assert {
    condition     = jsonencode(local.matrices.steady) == jsonencode(jsondecode(file("${path.module}/enabled/fixtures/matrix-steady.json"))) && jsonencode(local.matrices.bootstrap) == jsonencode(jsondecode(file("${path.module}/enabled/fixtures/matrix-bootstrap.json"))) && jsonencode(local.matrices.maintenance) == jsonencode(jsondecode(file("${path.module}/enabled/fixtures/matrix-maintenance.json"))) && jsonencode(local.matrices.deployment) == jsonencode(jsondecode(file("${path.module}/enabled/fixtures/matrix-deployment.json")))
    error_message = "The module's Deny matrix must equal the broker runtime's derivation in every form."
  }

  assert {
    condition     = length(google_service_account_iam_member.member_authority) == 61 && length(local.member_tuples) == 61 && length(local.invoker_tuples) == 8 && length(local.canary_tuples) == 1 && length(google_cloud_run_v2_service_iam_member.invokers) == 13
    error_message = "With every consumer commit recorded, exactly the sixty-one canonical consumer job tuples (fourteen per consumer, plus runsetta's five transition tuples) are bound to their member-delivery identities, and the identities, invokers, and reconciler hold run.invoker."
  }

  assert {
    condition = (
      sort(local.required_deny_matrix["cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.getOpenIdToken"].exceptions) == sort(concat(["principal://iam.googleapis.com/projects/-/serviceAccounts/service-123456789012@gcp-sa-cloudscheduler.iam.gserviceaccount.com"], local.invoker_tuples, local.member_tuples)) &&
      length(local.required_deny_matrix["cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.getOpenIdToken"].exceptions) == 1 + 8 + 61 &&
      alltrue([for tuple in local.member_tuples : startswith(tuple, "principalSet://iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/github-actions/attribute.authority/collinbentley1/") && !strcontains(tuple, "*")])
    )
    error_message = "The ID-token exception set must be exactly the Scheduler agent and the exact invoker and member tuples in the broker pool, never a wildcard."
  }

  assert {
    condition     = length(data.google_service_account.target) == 36 && alltrue([for key, account in data.google_service_account.target : account.unique_id == local.target_identities[key].unique_id && account.email == local.target_identities[key].email])
    error_message = "Every one of the thirty-six recorded identities must be read live and resolve to its recorded unique ID and email."
  }

  assert {
    condition     = length(google_project_iam_custom_role.actuator) == 4 && length(google_service_account_iam_member.actuator) == 36
    error_message = "Verified evidence and identities must plan exactly four actuator roles and thirty-six grants."
  }

  # The grant's member and role name are computed at apply; the account it
  # addresses is the overridden data source and is checked exactly here.
  assert {
    condition = alltrue([
      for key, grant in google_service_account_iam_member.actuator :
      grant.service_account_id == "projects/${lookup({ cdbentley = "cdbentley", critical-history = "critical-history-16823277", healthmcp = "medlock-1025243085", runsetta = "runsetta" }, split("/", key)[0])}/serviceAccounts/${split("/", key)[1]}@${lookup({ cdbentley = "cdbentley", critical-history = "critical-history-16823277", healthmcp = "medlock-1025243085", runsetta = "runsetta" }, split("/", key)[0])}.iam.gserviceaccount.com" &&
      !can(regex("/serviceAccounts/[0-9]", grant.service_account_id))
    ]) && sort(keys(google_service_account_iam_member.actuator)) == sort(keys(local.target_identities))
    error_message = "Each of the thirty-six grants must address its account by the email the provider accepts, in the account's own project; never by a bare unique ID."
  }

  assert {
    condition = alltrue([for consumer, role in google_project_iam_custom_role.actuator : role.role_id == "protectedRecoveryActuator" && role.project == local.consumers[consumer].projectId]) && google_project_iam_custom_role.actuator["cdbentley"].permissions == toset(["iam.serviceAccountKeys.list", "iam.serviceAccounts.get", "iam.serviceAccounts.getIamPolicy", "iam.serviceAccounts.setIamPolicy"])
    error_message = "One actuator role per consumer project, carrying exactly identity, key list, and allow-policy read and compare-and-set permissions."
  }

  assert {
    condition = (
      length(google_project_iam_custom_role.inventory) == 4 && length(google_project_iam_member.broker_inventory) == 4 &&
      alltrue([for consumer, role in google_project_iam_custom_role.inventory : role.role_id == "protectedRecoveryInventory" && role.project == local.consumers[consumer].projectId && !contains(role.permissions, "iam.serviceAccounts.getAccessToken") && !contains(role.permissions, "iam.serviceAccounts.setIamPolicy")]) &&
      alltrue([for consumer, grant in google_project_iam_member.broker_inventory : grant.project == local.consumers[consumer].projectId]) &&
      length(google_organization_iam_custom_role.inventory) == 1 && google_organization_iam_custom_role.inventory[0].org_id == "100000000001" && google_organization_iam_custom_role.inventory[0].role_id == "protectedRecoveryInventory" &&
      !contains(google_organization_iam_custom_role.inventory[0].permissions, "iam.serviceAccounts.getAccessToken") &&
      length(google_organization_iam_member.broker_inventory) == 1 && google_organization_iam_member.broker_inventory[0].org_id == "100000000001" &&
      length(google_organization_iam_member.broker_deny_reviewer) == 1
    )
    error_message = "The broker must hold exactly the read-only inventory role in every consumer project and at the evidenced organization, the deny reviewer role at the organization, and nothing that issues credentials or writes policies."
  }

  assert {
    condition     = local.evidence_verified && length(local.activation_blocked) == 0 && length(google_project_iam_custom_role.actuator) == 4 && length(google_service_account_iam_member.actuator) == 36 && length(google_project_iam_member.broker_inventory) == 4 && length(google_organization_iam_member.broker_inventory) == 1
    error_message = "Step two must grant exactly the four actuator roles, thirty-six actuator grants, four inventory grants, and one organization inventory grant, every one a mutation the matrix permits the applying identity."
  }
}

# Every adversarial run below applies: the reads that judge it are behind
# the fence and happen at apply, where every fenced authority resource that
# does not wait on another refuses -- the actuator roles, the inventory
# roles, the deny-reviewer grant; the grants that depend on a refused role
# are never reached -- and the grants that stand are untouched.
run "a_recreated_identity_at_the_same_address_is_refused" {
  command = apply

  override_data {
    target = data.google_service_account.target["cdbentley/gha-terraform"]
    values = {
      email     = "gha-terraform@cdbentley.iam.gserviceaccount.com"
      name      = "projects/cdbentley/serviceAccounts/gha-terraform@cdbentley.iam.gserviceaccount.com"
      unique_id = "199990000000000000000"
    }
  }

  expect_failures = [data.google_service_account.target]
}

# The records of any phase: a run GitHub does not record, a run of another
# head, an artifact whose recorded digest differs from the downloaded bytes,
# a control run that did not finish before the deny run began, and a cleanup
# run that did not begin after the deny run finished.
run "a_run_github_does_not_record_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:run-missing@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_control_run_of_another_head_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["control"]
    @@VERIFICATION:control:run-other-head@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "an_artifact_whose_recorded_digest_differs_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:artifact-digest@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_control_run_that_did_not_precede_the_deny_run_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["control"]
    @@VERIFICATION:control:control-after-deny@@
  }

  assert {
    condition     = contains(local.evidence_failures, "control_before_deny")
    error_message = "A control run updated after the deny run began must fail control_before_deny."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_cleanup_run_that_did_not_follow_the_deny_run_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["cleanup"]
    @@VERIFICATION:cleanup:cleanup-before-deny@@
  }

  assert {
    condition     = contains(local.evidence_failures, "cleanup_after_deny")
    error_message = "A cleanup run created before the deny run finished must fail cleanup_after_deny."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "a_cleanup_with_a_leftover_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["cleanup"]
    @@VERIFICATION:cleanup:cleanup-leftover@@
  }

  assert {
    condition     = contains(local.evidence_failures, "cleanup_predicate_bound")
    error_message = "A cleanup predicate with a leftover must fail cleanup_predicate_bound."
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

# The attestation of any phase: unverifiable, or signed by another
# workflow, run, head, repository, or runner.
run "an_attestation_gh_cannot_verify_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:unverified@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "an_unverifiable_control_attestation_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["control"]
    @@VERIFICATION:control:unverified@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "an_unverifiable_cleanup_attestation_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["cleanup"]
    @@VERIFICATION:cleanup:unverified@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

run "an_attestation_signed_by_another_workflow_is_refused" {
  command = apply

  override_data {
    target = data.external.canary_verification["deny"]
    @@VERIFICATION:deny:other-workflow@@
  }

  expect_failures = [google_project_iam_custom_role.actuator, google_project_iam_custom_role.inventory, google_organization_iam_custom_role.inventory, google_organization_iam_member.broker_deny_reviewer]
}

