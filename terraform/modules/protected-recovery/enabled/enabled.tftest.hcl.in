run "without_evidence_nothing_is_granted_even_with_every_identity_recorded" {
  command = plan

  variables {
    broker_authority_evidence = null
  }

  assert {
    condition     = local.identities_recorded && length(data.google_service_account.target) == 0 && length(google_project_iam_custom_role.actuator) == 0 && length(google_service_account_iam_member.actuator) == 0 && length(google_project_iam_custom_role.inventory) == 0 && length(google_organization_iam_custom_role.inventory) == 0
    error_message = "Recorded identities alone must grant nothing; only verified evidence enables authority."
  }
}

# The activation sequence from an empty broker project, applied with mock
# providers and state carried from run to run: the broker project alone
# without evidence, the evidenced grants once the Deny state stands and every
# mutation the apply makes is permitted its principal, and revocation of the
# grants when the evidence is withdrawn.
run "activation_step_one_installs_the_broker_project_alone" {
  command = apply

  variables {
    broker_authority_evidence = null
  }

  assert {
    condition     = length(google_project_iam_custom_role.actuator) == 0 && length(google_service_account_iam_member.actuator) == 0 && length(google_project_iam_member.broker_inventory) == 0 && length(google_organization_iam_member.broker_inventory) == 0 && length(data.google_project.consumer) == 0
    error_message = "Step one must create nothing in any consumer project and read none."
  }

  assert {
    condition     = length(google_service_account_iam_member.invoker_authority) == 8 && length(google_service_account_iam_member.member_authority) == 61 && length(google_service_account_iam_member.canary_authority) == 1 && length(google_cloud_run_v2_service_iam_member.invokers) == 13 && google_iam_workload_identity_pool_provider.members.workload_identity_pool_provider_id == "github-members"
    error_message = "Step one must create the broker project's identities and their bindings: invokers, member-delivery identities, and the Deny canary, so the canary can run before any grant exists."
  }
}

run "activation_step_two_grants_authority_under_the_evidenced_deny_state" {
  command = apply

  assert {
    condition     = local.evidence_verified && length(local.activation_blocked) == 0 && length(google_project_iam_custom_role.actuator) == 4 && length(google_service_account_iam_member.actuator) == 36 && length(google_project_iam_member.broker_inventory) == 4 && length(google_organization_iam_member.broker_inventory) == 1
    error_message = "Step two must grant exactly the four actuator roles, thirty-six actuator grants, four inventory grants, and one organization inventory grant, every one a mutation the matrix permits the applying identity."
  }
}

run "activation_step_three_revokes_authority_when_evidence_is_withdrawn" {
  command = apply

  variables {
    broker_authority_evidence = null
  }

  assert {
    condition     = length(google_project_iam_custom_role.actuator) == 0 && length(google_service_account_iam_member.actuator) == 0 && length(google_project_iam_member.broker_inventory) == 0 && length(google_organization_iam_member.broker_inventory) == 0 && length(google_service_account_iam_member.member_authority) == 61
    error_message = "Withdrawing the evidence must revoke every cross-project grant and keep the broker project's own identities."
  }
}
