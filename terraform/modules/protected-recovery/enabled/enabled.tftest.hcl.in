# The enabled path of the protected-recovery module: every target's permanent
# unique ID recorded and verified live, the Deny canary's attestation
# verified and bound to its signer, and the live Deny state bound to the
# attested one. The committed authority records no identity and no such
# records exist offline, so tools/ci/protected-recovery-enabled-test.sh
# renders this template into an isolated copy of the repository whose
# authority.json records a test identity for each of the thirty-six targets
# and the active platform commit for every consumer (plus a transition commit
# for runsetta), and whose mocked reads answer with fixtures/deny-canary.json
# and its adversarial variants. A line consisting of one of these placeholders
# (each wrapped in double at-signs) names the record rendered there:
#
#   VERIFICATION:<certificate>:<predicate>   the verified attestation, as
#       tools/ci/protected-recovery-verify-canary.sh answers it; certificate
#       variants consistent, other-workflow, other-run, other-head,
#       other-repository, self-hosted; predicate variants consistent,
#       extra-exception, unrelated-resource, missing-observation,
#       other-image, and unverified (verification refused outright)
#   LIVE_DENY_STATE   the live deny policies of every attachment point,
#       listed and read, exactly as attested
#   LIVE_DENY_POLICY:<variant>   the broker project's live policy with
#       one deviation: etag-moved, exception-widened, condition-added,
#       permission-missing
#   LIVE_DENY_LISTING:missing   the broker project's listing without its
#       policy
#
# and the ARTIFACT_SHA256 placeholder is the digest of the fixture bytes.
# These are mocked plan-shape and apply-shape tests: they prove what the gate
# does with each record and that the activation sequence is permitted by the
# matrix it requires, not that GitHub, gh, or Google answer as modelled. The
# identity of the test accounts is 1 + consumer index + account index +
# sixteen zeros, in the sorted order of protected-recovery/authority.json.

# The mocked apply of the activation sequence needs the computed names the
# dependent IAM resources validate to be well-formed; the values are shapes,
# not identities.
mock_provider "google" {
  mock_resource "google_service_account" {
    defaults = {
      email = "mocked@recovery-test.iam.gserviceaccount.com"
      name  = "projects/recovery-test/serviceAccounts/mocked@recovery-test.iam.gserviceaccount.com"
    }
  }
  mock_resource "google_project_iam_custom_role" {
    defaults = {
      name = "projects/recovery-test/roles/mocked"
    }
  }
  mock_resource "google_organization_iam_custom_role" {
    defaults = {
      name = "organizations/100000000001/roles/mocked"
    }
  }
}
mock_provider "http" {}
mock_provider "external" {}

