# GitHub's records of the canary run, its artifact, and the artifact's attestation.
override_data {
  target = data.http.canary_run[0]
  values = {
    status_code   = 200
    response_body = <<-JSON
      {"id":100000000002,"run_attempt":1,"status":"completed","conclusion":"success","head_sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","path":".github/workflows/protected-recovery-deny-canary.yml","event":"workflow_dispatch","repository":{"id":1255856466},"head_repository":{"id":1255856466}}
    JSON
  }
}

override_data {
  target = data.http.canary_artifact[0]
  values = {
    status_code   = 200
    response_body = <<-JSON
      {"id":100000000003,"name":"deny-canary","digest":"sha256:@@ARTIFACT_SHA256@@","expired":false,"workflow_run":{"id":100000000002,"head_sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}
    JSON
  }
}

# gh attestation verify's answer for the artifact, and the live Deny state.
override_data {
  target = data.external.canary_verification[0]
  @@VERIFICATION:consistent:consistent@@
}

@@LIVE_DENY_STATE@@

variables {
  project_id          = "recovery-test"
  broker_image        = "us-east4-docker.pkg.dev/recovery-test/broker/protected-recovery@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  active_workflow_sha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  broker_authority_evidence = {
    organization_id = "100000000001"
    deny_canary = {
      run_id          = "100000000002"
      artifact_id     = "100000000003"
      artifact_sha256 = "@@ARTIFACT_SHA256@@"
    }
  }
}

run "verified_evidence_and_verified_identities_grant_exactly_the_thirty_six_actuators" {
  command = plan

  assert {
    condition     = local.evidence_verified && length(local.evidence_failures) == 0 && length(local.unsatisfied_deny_rows) == 0 && length(local.live_unsatisfied_rows) == 0 && length(local.missing_live_permissions) == 0 && length(local.activation_blocked) == 0
    error_message = "Consistent records must pass every check with no unsatisfied Deny row, every live row as required, no required permission the live state does not deny, and no blocked activation mutation; failed checks [${join(", ", local.evidence_failures)}], unsatisfied rows [${join(", ", local.unsatisfied_deny_rows)}], live rows [${join(", ", local.live_unsatisfied_rows)}], missing [${join(", ", local.missing_live_permissions)}], blocked [${join(", ", local.activation_blocked)}]."
  }

  assert {
    condition     = local.canary_verified && local.certificate_bound && local.canary_certificate.buildSignerURI == "https://github.com/collinbentley1/platform/.github/workflows/protected-recovery-deny-canary.yml@refs/heads/main" && local.canary_certificate.runInvocationURI == "https://github.com/collinbentley1/platform/actions/runs/100000000002/attempts/1" && local.canary_certificate.sourceRepositoryDigest == var.active_workflow_sha
    error_message = "The verified certificate must bind the predicate to the deny-canary workflow at the active commit, the named run, and the platform repository."
  }

  assert {
    condition     = local.live_matches_canary && length(data.http.deny_policies) == 5 && length(data.http.deny_policy) == 5 && length(local.live_rules) == 5 + 4 * 4 && length(local.required_deny_matrix) == 33 + 4 * 26
    error_message = "Every attachment point's live deny policies must be read and be exactly the attested ones, and the whole matrix must be carried by them."
  }

  assert {
    condition     = length(google_service_account_iam_member.member_authority) == 61 && length(local.member_tuples) == 61 && length(local.invoker_tuples) == 8 && length(local.canary_tuples) == 1 && length(google_cloud_run_v2_service_iam_member.invokers) == 13
    error_message = "With every consumer commit recorded, exactly the sixty-one canonical consumer job tuples (fourteen per consumer, plus runsetta's five transition tuples) are bound to their member-delivery identities, and the identities, invokers, and reconciler hold run.invoker."
  }

  assert {
    condition = (
      sort(local.required_deny_matrix["cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.getOpenIdToken"].exceptions) == sort(concat(["principal://iam.googleapis.com/projects/-/serviceAccounts/service-123456789012@gcp-sa-cloudscheduler.iam.gserviceaccount.com"], local.invoker_tuples, local.member_tuples)) &&
      length(local.required_deny_matrix["cloudresourcemanager.googleapis.com/projects/recovery-test|iam.googleapis.com/serviceAccounts.getOpenIdToken"].exceptions) == 1 + 8 + 61 &&
      alltrue([for tuple in local.member_tuples : startswith(tuple, "principalSet://iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/github-actions/attribute.authority/collinbentley1/") && !strcontains(tuple, "*")])
    )
    error_message = "The ID-token exception set must be exactly the Scheduler agent and the exact invoker and member tuples in the broker pool, never a wildcard."
  }

  assert {
    condition     = length(data.google_service_account.target) == 36 && alltrue([for key, account in data.google_service_account.target : account.unique_id == local.target_identities[key].unique_id && account.email == local.target_identities[key].email])
    error_message = "Every one of the thirty-six recorded identities must be read live and resolve to its recorded unique ID and email."
  }

  assert {
    condition     = length(google_project_iam_custom_role.actuator) == 4 && length(google_service_account_iam_member.actuator) == 36
    error_message = "Verified evidence and identities must plan exactly four actuator roles and thirty-six grants."
  }

  # The grant's member and role name are computed at apply; the account it
  # addresses is the overridden data source and is checked exactly here.
  assert {
    condition = alltrue([
      for key, grant in google_service_account_iam_member.actuator :
      grant.service_account_id == "projects/${lookup({ cdbentley = "cdbentley", critical-history = "critical-history-16823277", healthmcp = "medlock-1025243085", runsetta = "runsetta" }, split("/", key)[0])}/serviceAccounts/${split("/", key)[1]}@${lookup({ cdbentley = "cdbentley", critical-history = "critical-history-16823277", healthmcp = "medlock-1025243085", runsetta = "runsetta" }, split("/", key)[0])}.iam.gserviceaccount.com" &&
      !can(regex("/serviceAccounts/[0-9]", grant.service_account_id))
    ]) && sort(keys(google_service_account_iam_member.actuator)) == sort(keys(local.target_identities))
    error_message = "Each of the thirty-six grants must address its account by the email the provider accepts, in the account's own project; never by a bare unique ID."
  }

  assert {
    condition = alltrue([for consumer, role in google_project_iam_custom_role.actuator : role.role_id == "protectedRecoveryActuator" && role.project == local.consumers[consumer].projectId]) && google_project_iam_custom_role.actuator["cdbentley"].permissions == toset(["iam.serviceAccountKeys.list", "iam.serviceAccounts.get", "iam.serviceAccounts.getIamPolicy", "iam.serviceAccounts.setIamPolicy"])
    error_message = "One actuator role per consumer project, carrying exactly identity, key list, and allow-policy read and compare-and-set permissions."
  }

  assert {
    condition = (
      length(google_project_iam_custom_role.inventory) == 4 && length(google_project_iam_member.broker_inventory) == 4 &&
      alltrue([for consumer, role in google_project_iam_custom_role.inventory : role.role_id == "protectedRecoveryInventory" && role.project == local.consumers[consumer].projectId && !contains(role.permissions, "iam.serviceAccounts.getAccessToken") && !contains(role.permissions, "iam.serviceAccounts.setIamPolicy")]) &&
      alltrue([for consumer, grant in google_project_iam_member.broker_inventory : grant.project == local.consumers[consumer].projectId]) &&
      length(google_organization_iam_custom_role.inventory) == 1 && google_organization_iam_custom_role.inventory[0].org_id == "100000000001" && google_organization_iam_custom_role.inventory[0].role_id == "protectedRecoveryInventory" &&
      !contains(google_organization_iam_custom_role.inventory[0].permissions, "iam.serviceAccounts.getAccessToken") &&
      length(google_organization_iam_member.broker_inventory) == 1 && google_organization_iam_member.broker_inventory[0].org_id == "100000000001"
    )
    error_message = "The broker must hold exactly the read-only inventory role in every consumer project and at the evidenced organization, and nothing that issues credentials or writes policies."
  }
}

